# Copy to .env at the repo root. Never commit .env.
# Secrets are shared through a private channel, never through Git or TEAM MESSAGE blocks.

# --- Server (P1) ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL of the Railway server, e.g. https://bubbleworks-server.up.railway.app
SERVER_PUBLIC_URL=
# Public URL of the Vercel live page, e.g. https://bubbleworks.vercel.app
WEB_PUBLIC_URL=
# SQLite file. Railway mounts a volume at /data, so set /data/bubbleworks.db there.
DATABASE_PATH=./data/bubbleworks.db
# true shortens every deadline to 60 seconds for rehearsals
DEMO_MODE=false
# With DEMO_MODE: plan start times as if it were this local time (HH:MM), so late rehearsals still book dinner
DEMO_PLAN_CLOCK=
# upsert personas, demo group, and data/venues.json at boot (idempotent)
SEED_ON_BOOT=true
# enables POST /api/dev/plans and /api/dev/plans/:id/step (header x-dev-secret). Leave empty to disable.
DEV_ROUTES_SECRET=
# E.164 number of the teammate who answers as the demo venue ("The Demo Table"). Never commit it.
DEMO_VENUE_PHONE=

# --- Photon / Spectrum (P2) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# terminal for local development, imessage only on the process holding the LINE LOCK
SPECTRUM_PROVIDER=terminal
# Hold one sender's burst of messages this long before handing it to the engine
MESSAGING_DEBOUNCE_MS=1500
# Terminal provider: the person that typing in the default chat speaks as (E.164)
MESSAGING_TERMINAL_PHONE=
# How the live page link renders: text ("🫧 Watch the bubbles decide: <url>", opens Safari), app (iMessage app card; asks to install the Spectrum app), richlink (bare URL)
MESSAGING_LINK_STYLE=text
# Send "Voting closed: X" when a poll closes (the live card already shows it)
MESSAGING_ANNOUNCE_POLL_CLOSE=false
# staged: headcount first, poll once enough are in, live link at deliberation. all_at_once: everything up front
MESSAGING_BUNDLE_MODE=staged

# --- Anthropic + Google (P3) ---
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# http://localhost:3000/oauth/google/callback locally; <SERVER_PUBLIC_URL>/oauth/google/callback on Railway
GOOGLE_REDIRECT_URI=
# P3 Phase 0 spike only: a teammate's own registered phone (E.164) for Find My / Focus
P3_TEST_ADDRESS=

# --- ElevenLabs + Vercel (P4) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Caller voice; empty keeps Jessica (cgSgspJ2msm6clMCkdW9)
ELEVENLABS_VOICE_ID=
# Twilio caller line (P4). Trial accounts only reach verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, e.g. +15551234567
TWILIO_PHONE_NUMBER=
# Caller: fake (default, no phone rings) or real (ElevenLabs over Twilio)
CALLER_MODE=fake
# Real mode dials only the demo venue plus these comma-separated E.164 numbers
CALLER_ALLOWED_NUMBERS=
# Real bookings open with the AI disclosure; false only for test-number calls
CALLER_DISCLOSE=true
CALLER_RING_TIMEOUT_S=20
CALLER_TIMEZONE=America/New_York
# Poll live calls this often as a webhook fallback; 0 disables
CALLER_POLL_MS=3000
# Written by pnpm p4:number
ELEVENLABS_PHONE_NUMBER_ID=
# Teammate phone for P4 test calls, E.164
TEST_CALL_NUMBER=
ELEVENLABS_WEBHOOK_SECRET=
# Post-call webhook id (pnpm p4:agent keeps it attached to the agent)
ELEVENLABS_POST_CALL_WEBHOOK_ID=
# Socket.io endpoint the live page connects to (usually SERVER_PUBLIC_URL)
NEXT_PUBLIC_SOCKET_URL=
