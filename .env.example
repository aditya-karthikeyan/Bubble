# Copy to .env at the repo root. Never commit .env.
# Secrets are shared through a private channel, never through Git or TEAM MESSAGE blocks.

# --- Server (P1) ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Public URL of the Railway server, e.g. https://bubbleworks-server.up.railway.app
SERVER_PUBLIC_URL=
# Public URL of the Vercel live page, e.g. https://bubbleworks.vercel.app
WEB_PUBLIC_URL=
# SQLite file. Railway mounts a volume at /data, so set /data/bubbleworks.db there.
DATABASE_PATH=./data/bubbleworks.db
# true shortens every deadline to 60 seconds for rehearsals
DEMO_MODE=false
# upsert personas, demo group, and data/venues.json at boot (idempotent)
SEED_ON_BOOT=true
# E.164 number of the teammate who answers as the demo venue ("The Demo Table"). Never commit it.
DEMO_VENUE_PHONE=

# --- Photon / Spectrum (P2) ---
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# terminal for local development, imessage only on the process holding the LINE LOCK
SPECTRUM_PROVIDER=terminal

# --- Anthropic + Google (P3) ---
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- ElevenLabs + Vercel (P4) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Socket.io endpoint the live page connects to (usually SERVER_PUBLIC_URL)
NEXT_PUBLIC_SOCKET_URL=
