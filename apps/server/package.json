{
  "name": "@bubbleworks/server",
  "version": "0.0.0",
  "private": true,
  "description": "Bubbleworks always-on server: Spectrum connection, plan engine, solver, timers, Socket.io, webhooks.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "phase0": "tsx --env-file-if-exists=../../.env scripts/phase0.ts",
    "phase1": "tsx --env-file-if-exists=../../.env scripts/phase1.ts",
    "venues:import": "tsx scripts/import-venues.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=../../.env -e \"import('./src/config.js').then(async ({loadConfig})=>{const {createRuntime}=await import('./src/runtime.js');const rt=createRuntime(loadConfig(),{seed:true});console.log(rt.seed);rt.close();})\"",
    "p2:phase1": "tsx --env-file-if-exists=../../.env scripts/p2-phase1.ts",
    "p3:phase0": "tsx --env-file-if-exists=../../.env scripts/p3/phase0.ts",
    "p3:oauth": "tsx --env-file-if-exists=../../.env scripts/p3/calendar.ts",
    "p3:phase1": "tsx --env-file-if-exists=../../.env scripts/p3/phase1.ts",
    "p2:phase2": "tsx --env-file-if-exists=../../.env scripts/p2-phase2.ts",
    "p4:agent": "tsx --env-file-if-exists=../../.env scripts/voice/agent.ts",
    "p4:number": "tsx --env-file-if-exists=../../.env scripts/voice/number.ts",
    "p4:testcall": "tsx --env-file-if-exists=../../.env scripts/voice/testcall.ts",
    "p4:phase0": "tsx --env-file-if-exists=../../.env scripts/voice/phase0.ts",
    "sim": "tsx --env-file-if-exists=../../.env scripts/sim.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@bubbleworks/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@grpc/grpc-js": "^1.14.6",
    "@photon-ai/advanced-imessage": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.2.0",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.4",
    "spectrum-ts": "12.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4"
  }
}
