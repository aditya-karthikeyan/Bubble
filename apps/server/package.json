{
  "name": "@bubbleworks/server",
  "version": "0.0.0",
  "private": true,
  "description": "Bubbleworks always-on server: Spectrum connection, plan engine, solver, timers, Socket.io, webhooks.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "phase0": "tsx --env-file-if-exists=../../.env scripts/phase0.ts"
  },
  "dependencies": {
    "@bubbleworks/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
