{
  "name": "bubbleworks",
  "private": true,
  "version": "0.0.0",
  "description": "Bubbleworks: bubble agents that plan dinner inside a friend group's iMessage chat.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "pnpm --filter @bubbleworks/server dev",
    "start:server": "pnpm --filter @bubbleworks/server start",
    "p1:phase0": "pnpm --filter @bubbleworks/server phase0",
    "p1:phase1": "pnpm --filter @bubbleworks/server phase1",
    "venues:import": "pnpm --filter @bubbleworks/server venues:import",
    "db:seed": "pnpm --filter @bubbleworks/server db:seed",
    "p2:phase1": "pnpm --filter @bubbleworks/server p2:phase1",
    "p3:phase0": "pnpm --filter @bubbleworks/server p3:phase0",
    "p3:oauth": "pnpm --filter @bubbleworks/server p3:oauth",
    "p3:phase1": "pnpm --filter @bubbleworks/server p3:phase1",
    "p2:phase2": "pnpm --filter @bubbleworks/server p2:phase2",
    "p4:agent": "pnpm --filter @bubbleworks/server p4:agent",
    "p4:number": "pnpm --filter @bubbleworks/server p4:number",
    "p4:testcall": "pnpm --filter @bubbleworks/server p4:testcall",
    "p4:phase0": "pnpm --filter @bubbleworks/server p4:phase0",
    "sim": "pnpm --filter @bubbleworks/server sim",
    "p1:phase2": "pnpm --filter @bubbleworks/server sim basic"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "patchedDependencies": {
      "@spectrum-ts/imessage@12.10.1": "patches/@spectrum-ts__imessage@12.10.1.patch"
    }
  }
}
